# ==============================================================================
# AI Startup Launch Assistant & All-in-One Platform Environment Configuration
# ==============================================================================

# Core Application Settings
SECRET_KEY=prod_grade_enterprise_key_99212_secure_token
FLASK_ENV=development
PORT=5000

# ------------------------------------------------------------------------------
# 1. AI Language Model Providers (Configurable Multi-Model Integration)
# ------------------------------------------------------------------------------
# Primary OpenAI API Key (Optional: system automatically falls back to built-in smart reasoning if omitted)
OPENAI_API_KEY=your_actual_openai_api_key_here

# Default Model: gpt-4o-mini, gpt-4o, gpt-3.5-turbo, or custom model name
AI_MODEL=gpt-4o-mini

# OpenAI-Compatible Base URL (For Groq, OpenRouter, DeepSeek, Together, Ollama, LM Studio)
# Examples:
# OpenRouter: https://openrouter.ai/api/v1
# Groq: https://api.groq.com/openai/v1
# Ollama local: http://localhost:11434/v1
OPENAI_BASE_URL=

# ------------------------------------------------------------------------------
# 2. Live Web Search & Research Providers
# ------------------------------------------------------------------------------
# DuckDuckGo live search works immediately with zero configuration required.
# If you prefer Tavily API or Google Custom Search, configure them below:
TAVILY_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ------------------------------------------------------------------------------
# 3. AI Image Generation Providers
# ------------------------------------------------------------------------------
# Pollinations FLUX engine works out of the box with zero key required.
# If OpenAI API Key is provided above, DALL-E 3 is automatically enabled.
STABILITY_API_KEY=

# ------------------------------------------------------------------------------
# 4. Social Media Hub OAuth Credentials (Optional)
# ------------------------------------------------------------------------------
# Configure developer app client credentials to enable direct OAuth flows
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

META_APP_ID=
META_APP_SECRET=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# ------------------------------------------------------------------------------
# 5. Database Configuration
# ------------------------------------------------------------------------------
# SQLite is used automatically (startup_platform.db) for zero server setup.
# Optional MongoDB connection string if legacy MongoDB is preferred:
MONGO_URI=
